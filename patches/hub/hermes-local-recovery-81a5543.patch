+
+async def recover_local_sessions_async(authority, *, schedule=False):
+    """:func:`recover_local_sessions` for a live loop.
+
+    Receipt reads run in a worker. Restores stay on this loop — worker threads hold the session
+    store lock across state.db writes, and a restore on the loop is what avoids that inversion —
+    in batches of ``_RECOVERY_BATCH``, yielding between them so a liveness probe's ``call_soon``
+    runs. The caller awaits this before work that needs the restored registry.
+    """
+    started = time.monotonic()
+    ids = await asyncio.to_thread(local_receipt_ids, authority)
+    total = len(ids)
+    done = 0
+    for chunk in _recovery_batches(ids):
+        loaded, pending = await asyncio.to_thread(_prefetch_recovery_batch, authority, chunk)
+        _apply_recovery_batch(authority, loaded, pending, schedule=schedule)
+        done += len(chunk)
+        _log_recovery_progress(done, total, started)
+        if done < total:
+            await asyncio.sleep(0)
+    if schedule:
+        await _rearm_persisted_closes_async(authority)
+    _log_recovery_finished(total, started)
+
+
+async def _rearm_persisted_closes_async(authority):
+    """Same rearm as :func:`_rearm_persisted_closes`, yielding between batches.
+
+    ``rearm_persisted_closes`` writes ``pending_closes`` and stays on this loop.
+    """
+    from gateway.session_viewer_close import rearm_persisted_closes
+    armed = list(rearm_persisted_closes(authority))
+    chunks = list(_recovery_batches(armed))
+    for index, chunk in enumerate(chunks):
+        _schedule_rearmed(authority, chunk)
+        if index + 1 < len(chunks):
+            await asyncio.sleep(0)
diff --git a/hermes_state_local.py b/hermes_state_local.py
index 572ba6ddba..346a57a9cb 100644
--- a/hermes_state_local.py
+++ b/hermes_state_local.py
@@ -261,6 +261,42 @@ def local_receipt(db, session_id):
         raise RuntimeStoreError('storage_unavailable') from exc
 
 
+# SQLite's default variable cap is 999. Stay under it so a boot scan of many receipts
+# is one query per chunk, not one query per receipt.
+_RECEIPT_READ_CHUNK = 400
+
+
+def local_receipts(db, session_ids: list[str]) -> dict[str, dict]:
+    """Parsed receipts for *session_ids*, missing and unparsable values omitted.
+
+    One ``state_meta`` query per chunk. Callers that need ``local_receipt``'s refusal
+    for a missing id treat absence here as that refusal and read that id alone.
+    """
+    found: dict[str, dict] = {}
+    ids = [sid for sid in session_ids if isinstance(sid, str) and sid]
+    for start in range(0, len(ids), _RECEIPT_READ_CHUNK):
+        chunk = ids[start:start + _RECEIPT_READ_CHUNK]
+        keys = [POLICY_PREFIX + sid for sid in chunk]
+        placeholders = ",".join("?" * len(keys))
+        with db._read_ctx() as conn:
+            rows = conn.execute(
+                f"SELECT key, value FROM state_meta WHERE key IN ({placeholders})",
+                keys,
+            ).fetchall()
+        by_key = {row[0]: row[1] for row in rows}
+        for sid, key in zip(chunk, keys):
+            raw = by_key.get(key)
+            if raw is None:
+                continue
+            try:
+                value = json.loads(raw)
+            except (TypeError, ValueError):
+                continue
+            if isinstance(value, dict):
+                found[sid] = value
+    return found
+
+
 def end_idle_local_session(db, *, epoch, session_id, target_id, reason):
     """Stamp ``ended_at`` on *target_id* only while the logical *session_id*'s FIFO is idle.
 
